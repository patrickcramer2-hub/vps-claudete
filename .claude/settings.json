git clone https://github.com/patrickcramer2-hub/vps-claudete.git /tmp/vps-repo \
  -b claude/intelligent-curie-ri5741 --depth=1 \
  && cp /tmp/vps-repo/dashboard/app.py /docker/claudete-dashboard/ \
