        "jsCode": "const existente = $input.first().json || {};\nconst lead = $('Buscar Próximo Lead SEFAS').first().json;\nconst telefone = lead.Telefone;\nconst novaLinha = $('Preparar Registro Histórico SEFAS').first().json.ultima_mensagem || '';\n\nconst estadoExistente = existente.estado_conversa || '';\nconst resetHistorico = estadoExistente === 'ENCERRADO';\nconst historicoBase = (!resetHistorico && existente.historico_conversa) ? existente.historico_conversa + '|||' : '';\n\nreturn [{\n  json: {\n    telefone_limpo: telefone,\n    paciente_nome: (existente.paciente_nome && String(existente.paciente_nome).trim()) ? existente.paciente_nome : (lead['Nome Completo'] || ''),\n    historico_conversa: historicoBase + novaLinha,\n    canal: 'outbound',\n    remoteJid: telefone + '@s.whatsapp.net',\n    estado_conversa: estadoExistente === 'HANDOFF' ? 'HANDOFF' : 'ATIVO',\n    campanha_ativa: 'SEFAS_OUTBOUND',\n    bloco_produto: 'DERMATO',\n  }\n}];"
