        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"number\": \"{{ (() => { const n = ($json.Telefone || '').toString().replace(/\\\\D/g, ''); if (n.length >= 10) return n.startsWith('55') ? n : '55' + n; throw new Error('Numero invalido: ' + n); })() }}\",\n  \"options\": {\n    \"delay\": 2500,\n    \"presence\": \"composing\"\n  },\n  \"text\": {{ JSON.stringify((() => {\n  const v = $json['Variação'];\n  const nome = $json['Primeiro Nome'] || 'amigo';\n  if (v === 'S1') return 'Oi, ' + nome + '. Aqui é da SEFAS Assistencial. A gente oferece plano de assistência familiar a partir de R$59 por mês — suporte completo pra família no momento mais difícil. Você teria interesse em conhecer?';\n  if (v === 'S2') return 'Oi, ' + nome + ', tudo bem? Você conhece a SEFAS Assistencial? É um plano que cuida da família no momento mais delicado, por um valor bem acessível. Gostaria de saber mais?';\n  throw new Error('Variação não suportada: ' + v);\n})()) }}\n}",
        "options": {}
      },
      "id": "50d718d6-f059-4909-8e17-5af96ad20b5e",
      "name": "Enviar Mensagem SEFAS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3904,
        -1040
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "disabled": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\n\nconst tel =\n  j.pacientePhone ||\n  j.replyTarget ||\n  j.key?.remoteJid?.replace(/\\D/g, '') ||\n  '';\n\nconst campanha =\n  j.campanha_ativa ||\n  j.Campanha ||\n  j.campanha ||\n  'SEFAS_OUTBOUND';\n\nconst variacaoCode = $('Buscar Próximo Lead SEFAS').first().json['Variação'] || '';\nconst primeiroNome = $('Buscar Próximo Lead SEFAS').first().json['Primeiro Nome'] || '';\nconst bloco_produto =\n  $('Buscar Próximo Lead SEFAS').first().json['Bloco Produto'] ||\n  j['Bloco Produto'] || j.bloco_produto ||\n  (campanha.includes('CLUBE') ? 'CLUBE_CCN' : campanha.includes('DERMATO') ? 'DERMATO' : 'CHECK_UP');\n\nconst textosPorVariacao = {\n  // ── CHECK-UP (Dia das Mães 2026) ──\n  'A1': `${primeiroNome}, tudo bem? A CCN completa 6 anos em agosto e os check-ups estão com desconto especial só até o final do mês. Em setembro voltam ao preço normal. Posso te passar as opções?`,\n  'A2': `${primeiroNome}, tudo bem? Passando pra avisar: em agosto os check-ups da CCN estão com condição especial de aniversário. Quem agendar e realizar este mês garante o desconto. Depois disso volta ao valor normal. Quer saber o que está incluso?`,\n  'B1': `${primeiroNome}, tudo bem? Você já foi paciente da CCN e queria te avisar antes que o mês acabe: estamos com desconto especial de aniversário nos check-ups, válido só para quem realiza em agosto. Posso te contar como funciona?`,\n  'B2': `${primeiroNome}, tudo bem? A CCN está com check-ups com desconto de aniversário, mas só até 31 de agosto. Depois volta ao preço cheio. Vale a pena aproveitar agora. Posso te passar as opções?`,\n  'C1': `${primeiroNome}, tudo bem? 💚 Aqui é da equipe da CCN, em Niterói.\\n\\nNeste mês das mães, estamos oferecendo uma opção de check-up para quem quer colocar a saúde em dia com mais tranquilidade.\\n\\nInclui consulta médica, exames e retorno para avaliação dos resultados, tudo com hora marcada.\\n\\nPosso te passar as informações?`,\n  // ── DERMATOLOGIA (Dr. Nikollas) ──\n  'D1': `${primeiroNome}, tudo bem? Aqui e do Centro Clinico Niteroi. Em agosto, mes do nosso aniversario, estamos com condicao especial pra avaliacao preventiva de pele, mapeamento de pintas e sinais, com o dermatologista. Consulta por R$135 (de R$180) via Pix, para quem agenda e comparece esse mes. Vagas nos dias 17, 20, 27 e 31 (nosso aniversario). Voce tem interesse em marcar um horario?`,\n  'D2': `${primeiroNome}, tudo bem? Centro Clinico Niteroi aqui. Voce ja fez uma avaliacao preventiva da pele, com mapeamento de pintas e sinais? Em agosto, mes do nosso aniversario, a consulta de dermatologia sai por R$135 via Pix (normalmente R$180), pra quem agenda e vem esse mes. Vagas nos dias 17, 20, 27 e 31, esse ultimo e o dia exato do nosso aniversario. Quer que eu veja o horario que funciona melhor pra voce?`,\n  // ── CLUBE CCN (até 59 anos) ──\n  'CA': `${primeiroNome}, tudo bem? 👋 Aqui é da CCN, em Niterói.\\n\\nCriamos um clube para quem quer cuidar da saúde de forma inteligente. A ideia é simples: você paga R$47/mês e quanto mais saudável ficar, mais ganha.\\n\\nFicou 6 meses sem precisar de médico? A CCN te dá um check-up completo de R$499, de presente.\\n\\nFaz sentido te contar mais?`,\n  'CB': `${primeiroNome}, tudo bem? 👋 Aqui é da CCN, em Niterói.\\n\\nLançamos um clube de saúde com uma lógica diferente: você paga R$47/mês e as consultas que seriam R$180 ficam em R$90. E ficou 6 meses sem usar? A gente te dá um check-up Intermediário de presente.\\n\\nQuer saber como funciona?`,\n  // ── CLUBE CCN 60+ (60 anos ou mais) ──\n  'SA': `${primeiroNome}, tudo bem? 👋 Aqui é da CCN, em Niterói.\\n\\nCriamos um clube para quem quer cuidar da saúde de forma inteligente. A ideia é simples: você paga R$97/mês e quanto mais saudável ficar, mais ganha.\\n\\nFicou 6 meses sem precisar de médico? A CCN te dá uma consulta de Geriatria e um check-up Essencial (R$299), de presente.\\n\\nFaz sentido te contar mais?`,\n  'SB': `${primeiroNome}, tudo bem? 👋 Aqui é da CCN, em Niterói.\\n\\nLançamos um clube para maiores de 60 anos com uma lógica diferente: você paga R$97/mês e consultas ficam em R$90, Geriatria em R$150. E ficou 6 meses sem usar? A gente te dá uma consulta de Geriatria + check-up Essencial de presente.\\n\\nQuer saber como funciona?`,\n};\n\nconst mensagemAbertura = textosPorVariacao[variacaoCode] || `${primeiroNome}, tudo bem? 💚 Aqui é da equipe da CCN, em Niterói.\\n\\nEstamos avisando alguns contatos sobre uma opção de check-up disponível neste mês, com consulta médica, exames e retorno para avaliação dos resultados.\\n\\nÉ tudo com hora marcada, pensado para facilitar o cuidado preventivo.\\n\\nPosso te contar mais?`;\n\nconst texto = j.resposta || j.modelText || j.text || '';\n\nconst especialidade = j.especialidade || (campanha.includes('DERMATO') ? 'dermatologia' : 'check-up');\nconst medico = j.medico || (campanha.includes('DERMATO') ? 'Dr. Nikollas Munhoz Andrade' : '');\n\nlet status_lead = 'em_conversa';\nif (texto.includes('[AGENDADO:')) {\n  status_lead = 'agendado';\n} else if (texto.toLowerCase().includes('não') || texto.toLowerCase().includes('depois')) {\n  status_lead = 'recusou';\n}\n\nconst historicoAnterior = j.historico_conversa || '';\nlet historico = '';\n\nif (!historicoAnterior && mensagemAbertura && !texto) {\n  historico = 'claudete:: ' + mensagemAbertura;\n} else if (!historicoAnterior && mensagemAbertura && texto) {\n  historico = 'claudete:: ' + mensagemAbertura + ' ||| claudete:: ' + texto;\n} else if (historicoAnterior && texto) {\n  historico = historicoAnterior + ' ||| claudete:: ' + texto;\n} else if (historicoAnterior) {\n  historico = historicoAnterior;\n} else {\n  historico = texto ? 'claudete:: ' + texto : '';\n}\n\nreturn [{\n  json: {\n    chave_demanda: tel + '_' + campanha,\n    telefone_limpo: tel,\n    paciente_nome: j.pacienteNome || j.pushName || primeiroNome,\n    historico_conversa: historico,\n    ultima_mensagem: 'claudete:: ' + mensagemAbertura,\n    ultima_interacao_ts: new Date().toISOString(),\n    ultimo_numero_origem: '552120423575',\n    canal: 'whatsapp',\n    responsavel: 'claudete',\n    contexto_ativo: 'outbound',\n    origem_demanda: 'outbound',\n    status_conversa: 'ativa',\n    campanha_ativa: campanha,\n    variacao_mensagem: variacaoCode,\n    bloco_produto,\n    especialidade,\n    medico,\n    status_lead,\n    flag_humano: 'NAO',\n    handoff: 'NAO',\n    flag_teste: 'SIM',\n    json_valido: 'SIM'\n  }\n}];"
      },
