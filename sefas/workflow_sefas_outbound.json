    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst hoje = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' }); // YYYY-MM-DD\n\nlet contagemHoje = 0;\nfor (const r of rows) {\n  if (r.canal !== 'outbound') continue;\n  const ts = r.ultima_interacao_ts;\n  if (!ts) continue;\n  const dataLocal = new Date(new Date(ts).toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));\n  const tsDia = dataLocal.toLocaleDateString('en-CA');\n  if (tsDia === hoje) contagemHoje++;\n}\n\nconst TETO = 50;\nconst paciente = $('Tem Lead Pendente?').item.json;\n\nreturn [{\n  json: {\n    ...paciente,\n    contagemHoje,\n    teto: TETO,\n    tetoAtingido: contagemHoje >= TETO\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
