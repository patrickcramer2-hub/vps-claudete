# ─── Claudete Dashboard — variáveis de ambiente ───────────────────────────────
# Copie para .env e preencha com os valores do cliente.
# NUNCA commite .env com credenciais reais.

# ── Quark API (obrigatório) ──
QUARK_AUTH_TOKEN=
QUARK_CHAVE_KEY=
QUARK_SECRET_KEY=

# ── Chatwoot ──
# URL do Chatwoot do cliente (ex: https://chat.clinicaxyz.com.br)
CHATWOOT_BASE=https://chat.centrocliniconiteroi.com.br
# Token de API do Chatwoot (Perfil > Tokens de Acesso)
CHATWOOT_API_TOKEN=
# ID da conta Chatwoot (ver URL: /app/accounts/1/...)
CHATWOOT_ACCOUNT_ID=1
# Agentes Chatwoot — JSON: {"1":"Nome1","2":"Nome2"}
CHATWOOT_AGENT_NAMES_JSON={"1":"Patrick","2":"Mariana","3":"Maristela","4":"Tatiara"}

# ── Evolution API ──
# Instâncias WhatsApp separadas por vírgula (primeira = canal principal)
EVOLUTION_INSTANCES=Claudete-recep,claudete2

# ── Time / Quark ──
# Mapa usuarioCadastroId → Nome — JSON: {"419311307":"Mariana","43802210":"Patrick"}
USUARIO_MAP_JSON={"419311307":"Mariana","43802210":"Patrick","197920870":"Tatiara","281621535":"Maristela","456143596":"API/Claudete"}
# Time comercial com hashtags WA — JSON array
TEAM_MEMBERS_JSON=[{"uid":419311307,"nome":"Mariana","wa_hashtag":"mariana"},{"uid":281621535,"nome":"Maristela","wa_hashtag":"maristela"},{"uid":43802210,"nome":"Patrick","wa_hashtag":null},{"uid":197920870,"nome":"Tatiara","wa_hashtag":null}]
# ID do usuário Quark que representa agendamentos via integração (Claudete)
USUARIO_API_ID=456143596

# ── Financeiro ──
# Ticket médio fallback em R$ (usado quando sem dados recentes)
TICKET_MEDIO_FALLBACK=322

# ── IDs institucionais ──
# IDs Quark de cadastros internos que não são pacientes — JSON array
PESSOA_ID_INSTITUCIONAL_JSON=[229046903]

# ── Banco Evolution (PostgreSQL) ──
EVOLUTION_DB_HOST=
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_NAME=
EVOLUTION_DB_USER=
EVOLUTION_DB_PASSWORD=
